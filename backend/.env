AYA_DATABASE_URL=sqlite:///./aya-local.db
AYA_REDIS_URL=redis://localhost:6379/0
AYA_STORAGE_ROOT=./data
AYA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AYA_MAX_UPLOAD_BYTES=52428800
AYA_INLINE_JOBS=false
AYA_LOCAL_JOBS=true
MODEL_TEMPLATE_CACHE_DIR=./data/template-cache
# Шрифты шаблонов: хранилище приложения и загрузка открытых шрифтов из Google Fonts (0 — не скачивать).
AYA_FONT_DIR=./data/fonts
AYA_FONT_DOWNLOAD=1

# OpenRouter is the only model gateway. The key belongs on the worker only.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_PROVIDER_SORT=throughput
MODEL_TEMPLATE_ANALYST=qwen/qwen3-vl-32b-instruct
MODEL_DECK_PLANNER=qwen/qwen3.8-27b
MODEL_SLIDE_WORKER=qwen/qwen3.8-27b
MODEL_INFOGRAPHIC_DESIGNER=qwen/qwen3.8-27b
MODEL_DARK_THEME_DESIGNER=qwen/qwen3.8-27b
MODEL_DECK_CRITIC=google/gemma-4-31b-it
MODEL_PROMPT_CRITIC=google/gemma-4-31b-it
MODEL_VISUAL_CRITIC_MODEL=google/gemma-4-31b-it
MODEL_SLIDE_REPAIR=qwen/qwen3.8-27b
MODEL_VISUAL_CRITIC=1
MODEL_REPAIR_ROUNDS=1
MODEL_MAX_PARALLEL=4
MODEL_TIMEOUT_SECONDS=45
MODEL_REQUEST_BUDGET_SECONDS=75
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=1
MODEL_REQUESTS_PER_MINUTE=120
MODEL_TOKENS_PER_MINUTE=0
MODEL_ANALYSIS_RPM=60
MODEL_FREE_ONLY=0
# Строгий режим шаблона: текст только в места шаблона, их шрифт, кегль и цвет, не длиннее исходного текста (0 — прежняя адаптивная раскладка).
AYA_STRICT_TEMPLATE=1
